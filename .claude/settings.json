{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(npm run lint:*)",
      "Read(./**)",
      "Bash(npm run dev:*)",
      "Bash(npm run db:migrate:*)",
      "Bash(npm run db:generate:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm test:*)",
      "Bash(docker compose:*)",
      "Bash(docker ps:*)",
      "Bash(npx dotenv:*)",
      "Bash(npx playwright:*)",
      "Bash(node:*)",
      "Bash(npx tsx:*)",
      "Bash(curl:http://localhost:*)",
      "Bash(mkdir:*)",
      "Bash(taskkill:*)",
      "Bash(lsof:*)",
      "Bash(netstat:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(rm -rf:*)",
      "Bash(curl:*)",
      "Bash(gh pr merge:*)"
    ]
  }
}